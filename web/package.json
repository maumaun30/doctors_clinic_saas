{
  "name": "doctors-clinic-saas-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public | node scripts/sort-types.mjs > lib/database.types.ts",
    "gen:types:local": "supabase gen types typescript --local --schema public | node scripts/sort-types.mjs > lib/database.types.ts",
    "gen:types:db": "supabase gen types typescript --db-url \"$DATABASE_URL\" --schema public | node scripts/sort-types.mjs > lib/database.types.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.55.0",
    "next": "^15.0.0",
    "radix-ui": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.15",
    "shadcn": "^4.21.4",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0"
  }
}
