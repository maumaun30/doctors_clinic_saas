NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
# Stripe billing (server-only). Leave empty to run without billing UI actions.
STRIPE_SECRET_KEY=
# Recurring monthly per-seat price; quantity = number of doctors.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Error monitoring (optional). Unset = disabled.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (optional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Help & support: Viber number for the "Message us on Viber" button, in
# international format (e.g. +639171234567). Unset hides the button.
NEXT_PUBLIC_SUPPORT_VIBER=
